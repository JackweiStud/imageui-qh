# Google Gemini
# 官方 API 与反向代理共用这一把 key。走反代时填写 Antigravity Tools 接受的 key。
GEMINI_API_KEY=

# 可选。设置后所有 Gemini 调用发往该地址（SDK 会自行拼接 /v1beta/models/...:generateContent）。
# 填源站根地址，不要带 /v1beta；若带了，程序会去掉。
# 例: https://your-tunnel.trycloudflare.com
# GEMINI_BASE_URL=

# 图像模型（风格转换、参考图、换身、局部重绘、虚拟试衣）。
# 默认 gemini-3.1-flash-image：Google 官方稳定版 ID，也是反代上已验证可用的 ID。
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 自由创作模型。默认 gemini-3-pro-image（官方 GA，替代已下线的 gemini-3-pro-image-preview）。
# 该 ID 在 Antigravity 反代上会 503（没有可用账号）。指向反代时改为 gemini-3.1-flash-image。
# GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image

# 提示词增强（纯文本）。默认 gemini-3-flash-preview（Google 官方当前 ID）。
# 反代的 ID 是 gemini-3-flash（没有 -preview）。指向反代时必须覆盖。
# GEMINI_TEXT_MODEL=gemini-3-flash-preview

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 可选。用于访问官方 Google API。设置 GEMINI_BASE_URL 后，该主机名会加入 NO_PROXY，
# Gemini 请求直连隧道，其它出站请求仍走这里的代理。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
